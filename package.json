{
  "name": "grave-goods-app",
  "version": "1.0.0",
  "private": true,
  "description": "Capacitor iOS shell for Grave Goods (Relic Wall)",
  "type": "module",
  "scripts": {
    "build:www": "node scripts/build-www.mjs",
    "sync": "npm run build:www && npx cap sync ios",
    "patch:ios": "node scripts/patch-ios.mjs",
    "test": "node --test --test-concurrency=1 \"tests/*.test.mjs\"",
    "test:unit": "node --test tests/build-www.test.mjs tests/telemetry.test.mjs tests/remote-config.test.mjs tests/save-adapter.test.mjs tests/ads.test.mjs tests/interstitial.test.mjs tests/payments.test.mjs tests/store-assets.test.mjs tests/ios-patch.test.mjs tests/android-patch.test.mjs",
    "test:smoke": "node --test tests/smoke.test.mjs",
    "patch:android": "node scripts/patch-android.mjs",
    "storekit": "node scripts/gen-storekit.mjs",
    "asc:products": "node scripts/asc-products.mjs"
  },
  "dependencies": {
    "@capacitor-community/admob": "7.2.0",
    "@capacitor/android": "^7.6.9",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.9",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/ios": "^7.6.9",
    "@capacitor/preferences": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "capacitor-icloud-kv": "file:plugins/icloud-kv",
    "capacitor-play-billing": "file:plugins/play-billing",
    "capacitor-storekit": "file:plugins/storekit"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.9",
    "playwright": "1.56.0"
  },
  "engines": {
    "node": ">=20"
  }
}
